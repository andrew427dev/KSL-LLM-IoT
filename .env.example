# Gemini API
GEMINI_API_KEY=your_gemini_api_key_here

# Model settings
MODEL_PATH=model/ksl_model.tflite
CONFIDENCE_THRESHOLD=0.85
SEQUENCE_LENGTH=30
# 무동작 자동 문장화(초). 기본 3.0 — 침묵 자동 발화를 완료 버튼과 병행. 0 = 비활성(버튼 전용)
SILENCE_TRIGGER_SEC=3.0
# 같은 단어 재인식 차단 창(초) — 동작 유지 시 중복 단어 누적 방지
DUPLICATE_FILTER_SEC=3.0
HANDEDNESS_SCORE_THRESHOLD=0.7
NO_HAND_RESET_FRAMES=10
# 학습 실험 전용 — 쉼표 구분 목록으로 KSL_LABELS 대체 (운용 배포에서는 비움)
KSL_LABELS_OVERRIDE=

# 문장 생성 문체 — 정중 / 친근 / 간단 (GUI 모드에서는 'p' 키로 실행 중 변경)
SENTENCE_PERSONA=정중

# LCD I2C
LCD_I2C_ADDRESS=0x27
LCD_NUM_COLS=20
LCD_NUM_ROWS=4

# GPIO (BCM 번호)
BUZZER_PIN=17
# 물리 버튼 — 각 핀과 GND 사이에 버튼 연결 (내부 풀업, 외부 저항 불필요)
BUTTON_COMPLETE_PIN=5
BUTTON_PERSONA_POLITE_PIN=6
BUTTON_PERSONA_FRIENDLY_PIN=13
BUTTON_PERSONA_BRIEF_PIN=19
BUTTON_DEBOUNCE_MS=300

# TTS
TTS_LANGUAGE=ko
TTS_OFFLINE_MODE=false

# Camera
CAMERA_INDEX=0
CAMERA_WIDTH=640
CAMERA_HEIGHT=480
CAMERA_FPS=30
