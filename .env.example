# Gemini API
GEMINI_API_KEY=your_gemini_api_key_here

# Model settings
MODEL_PATH=model/ksl_model.tflite
CONFIDENCE_THRESHOLD=0.85
SEQUENCE_LENGTH=30
SILENCE_TRIGGER_SEC=3.0

# LCD I2C
LCD_I2C_ADDRESS=0x27
LCD_NUM_COLS=20
LCD_NUM_ROWS=4

# GPIO
BUZZER_PIN=17

# TTS
TTS_LANGUAGE=ko
TTS_OFFLINE_MODE=false
